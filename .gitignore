# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the placeholder template. README and docs/DOCKER-SETUP.md both start with
# `cp .env.template .env`, which only works if the template is actually in the repository.
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
dev.db-journal

# Derived from schema.prisma by prisma.config.ts when DATABASE_URL points at MySQL —
# regenerated on every Prisma CLI run, never edited by hand.
/prisma/schema.mysql.prisma

# local AI-assistant config — personal to whoever is working on the repo.
# The agent skills that DO ship with the project live in .agents/skills/.
.claude/
.zcode/

# Local SQLite databases, WAL sidecars and automatic pre-update backups.
# OPENGSC local databases: a production install points DATABASE_URL at data/prod.db, and
# scripts/backup-sqlite.mjs writes next to it. None of that may ever enter the repository.
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/backups/
backups/
*.db-wal
*.db-shm
