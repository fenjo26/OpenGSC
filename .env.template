# ─────────────────────────────────────────────────────────
# DATABASE
# Локально: file:./data/dev.db
# VPS: абсолютный путь, например file:/home/user/seogets/data/prod.db
# ─────────────────────────────────────────────────────────
# An absolute path is safest; a relative one resolves against whatever directory the process
# starts in. Keep the database under data/ — it is gitignored, so `git reset --hard` during an
# update cannot touch it. Never point this at ./dev.db: that file is tracked by git.
DATABASE_URL="file:./data/dev.db"

# ─────────────────────────────────────────────────────────
# NEXTAUTH
# Генерация секрета: openssl rand -base64 32
# URL: http://localhost:3000 (локально)
#      https://yourdomain.com (VPS + домен + SSL)
#      http://YOUR_IP:3000   (VPS без домена)
# ─────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"
# Optional stable key for encrypting Content Operations repository tokens. If omitted,
# NEXTAUTH_SECRET is used; changing either key makes previously saved tokens unreadable.
# CONTENT_OPS_SECRET="generate_an_independent_secret_here"

# ─────────────────────────────────────────────────────────
# GOOGLE OAUTH CREDENTIALS
# Создать в: https://console.cloud.google.com/
# APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: {NEXTAUTH_URL}/api/auth/callback/google
# Authorized JavaScript origins: {NEXTAUTH_URL}
# ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
# Optional contributor-only prototype screens. Team/Members/Super Sites do not have a server-side
# organization or authorization model yet, so production installs should leave this unset.
# NEXT_PUBLIC_EXPERIMENTAL_TEAM_UI=1

# ─────────────────────────────────────────────────────────
# NETWORK SAFETY
# ─────────────────────────────────────────────────────────
# Off by default. OpenGSC refuses to fetch localhost, LAN and other non-public addresses, because
# a URL field that reaches the host network is the classic SSRF hole. Set this to 1 only if you
# audit a staging site that lives on the same machine or network as the instance.
# Разрешает аудит локальных адресов (localhost, 192.168.x.x). Публичный Free SEO Checker
# остаётся строгим при любом значении.
# OPENGSC_ALLOW_PRIVATE_TARGETS=1

# ── easy.gr: availability for .gr, the zone no public registry answers for ────────────────────
# .gr has no RDAP endpoint and no public WHOIS server: IANA publishes empty `whois:` and `refer:`
# fields for the zone, and `gr` is absent from the RDAP bootstrap. A registrar API is the only
# source, and easy.gr is the one wired up.
#
# Get the pair in the easy.gr control panel by switching "Σύνδεση στο API" on. Turning that
# switch off and on again REGENERATES both values, which is also how you rotate them.
#
# Their API is IP-allowlisted: declare this server's outbound IP in the same panel, or every
# call comes back {"done":0,"errors":{"password":"unauthorized"}} no matter how right the
# credentials are. For the same reason these calls never go through the drops proxy pool.
# EASY_GR_USERNAME=
# EASY_GR_PASSWORD=
